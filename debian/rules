#!/usr/bin/make -f
# Rust is built with cargo directly; dependencies must already be in
# $CARGO_HOME (packaging/Dockerfile runs `cargo fetch` first), so the
# package build itself never touches the network.

include /usr/share/dpkg/pkg-info.mk

# Pass Debian's hardening CFLAGS/LDFLAGS to C code built by crates (cc crate).
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
DPKG_EXPORT_BUILDFLAGS = 1
include /usr/share/dpkg/buildflags.mk

export DH_VERBOSE = 1
export CARGO_TARGET_DIR = $(CURDIR)/debian/cargo-target
export CARGO_NET_OFFLINE = true
# Line tables give dh_strip something to put in the -dbgsym package and make
# panic backtraces useful; remapping keeps build paths out of the binary.
export CARGO_PROFILE_RELEASE_DEBUG = line-tables-only
export RUSTFLAGS = --remap-path-prefix=$(CURDIR)=. --remap-path-prefix=$(CARGO_HOME)=/cargo

PKG := agent-memory-mcp
BIN := $(CARGO_TARGET_DIR)/release/$(PKG)

%:
	dh $@

override_dh_auto_clean:
	rm -rf $(CARGO_TARGET_DIR) debian/$(PKG).8

# debian/changelog's version is what apt deploys; refuse to build if
# Cargo.toml or the plugin manifests disagree with it.
override_dh_auto_configure:
	scripts/check-versions.sh

# Options come from --help so they can't drift from the binary; the
# configuration, environment, files and examples sections are hand-written in
# debian/$(PKG).h2m. check-manpage.sh fails the build if either half is lost.
override_dh_auto_build:
	cargo build --release --locked
	help2man --no-info --section=8 --version-string="$(DEB_VERSION_UPSTREAM)" \
		--name="shared long-term memory MCP server for coding agents" \
		--include=debian/$(PKG).h2m \
		--output=debian/$(PKG).8 $(BIN)
	scripts/check-manpage.sh $(BIN) debian/$(PKG).8

# Integration tests run only when MONGODB_TEST_URI is set; unit tests always run.
override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	cargo test --release --locked
endif

override_dh_auto_install:
	install -D -m 0755 $(BIN) debian/$(PKG)/usr/sbin/$(PKG)
	install -D -m 0644 debian/$(PKG).envfile debian/$(PKG)/etc/default/$(PKG)

# /etc/default/$(PKG) is the EnvironmentFile, and a MongoDB URI can carry
# credentials, so keep it root-only. systemd reads it before dropping to the
# DynamicUser, so the service still sees it.
override_dh_fixperms:
	dh_fixperms
	chmod 0600 debian/$(PKG)/etc/default/$(PKG)

# dwz does not understand Rust's DWARF well and adds nothing for a single binary.
override_dh_dwz:
